    "p3": {
      "type": "Text",
      "props": {
        "text": "表格按横向版心的宽度排，14 列放得下。"
      }
    },
    "s3": {
      "type": "Section",
      "props": {
        "orientation": "portrait",
        "margin": "20mm"
