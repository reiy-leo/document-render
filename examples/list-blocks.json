{
  "version": "0.1",
  "meta": { "title": "列表项里放多段、表格、图片、代码", "lang": "zh-CN", "page": { "size": "A4", "margin": "20mm" } },
  "root": "doc",
  "elements": {
    "doc": { "type": "Document", "children": ["title", "steps", "after", "notes"] },
    "title": { "type": "Heading", "props": { "level": 2, "text": "安装步骤" } },
    "steps": {
      "type": "List",
      "props": {
        "ordered": true,
        "items": [
          { "text": "下载安装包。", "children": ["s1-more", "s1-code"] },
          {
            "text": "按下表选好版本：",
            "children": ["s2-table", "s2-more"],
            "items": [{ "text": "子项也能带续块：", "children": ["s2a-more"] }, "普通子项"]
          },
          { "text": "装好后会看到下面的界面：", "children": ["s3-image", "s3-quote"] },
          "完成。"
        ]
      }
    },
    "s1-more": { "type": "Text", "props": { "text": "这是第一项的第二段：没有编号，左边和「下载安装包」对齐。" } },
    "s1-code": { "type": "Code", "props": { "code": "curl -LO https://example.com/document-render.tar.gz\ntar xzf document-render.tar.gz", "language": "sh" } },
    "s2-table": {
      "type": "Table",
      "props": {
        "columns": ["系统", "安装包"],
        "rows": [["macOS", "document-render-aarch64-apple-darwin.tar.xz"], ["Linux", "document-render-x86_64-unknown-linux-gnu.tar.xz"]],
        "widths": [1, 3]
      }
    },
    "s2-more": { "type": "Text", "props": { "text": "表格的左边框也对齐到项的文字。" } },
    "s2a-more": { "type": "Text", "props": { "text": "第二级的续块对齐到第二级的文字。" } },
    "s3-image": { "type": "Image", "props": { "src": "list-image.png", "alt": "示意图", "width": 120 } },
    "s3-quote": { "type": "Quote", "props": { "text": "引用、提示框、公式也能放进列表项。" } },
    "after": { "type": "Text", "props": { "text": "列表后面的正文照常从左边开始。" } },
    "notes": {
      "type": "List",
      "props": { "items": [{ "text": "无序列表也一样", "children": ["n1-more"] }, "第二点"] }
    },
    "n1-more": { "type": "Text", "props": { "text": "续段落在圆点后面文字的位置。" } }
  }
}
